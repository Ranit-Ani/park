# Copy this file to .env (or .env.local) and fill in real values.
# All Vite env vars exposed to the browser MUST be prefixed with VITE_.

# ── Landing page → Help & Support modal ─────────────────────────────
# Address the "Email Support" button opens (mailto:) and that the
# Contact Us form's messages should ultimately reach.
VITE_SUPPORT_EMAIL=support@carparkingnetwork.com

# EmailJS (https://www.emailjs.com/) powers the "Contact Us" form on the
# public Landing page so a message can be sent without a backend route.
# Create a free account, an Email Service, and an Email Template with
# {{from_name}}, {{from_email}} and {{message}} variables, then fill these
# in. If left unset, the Contact Us form disables itself gracefully and
# tells the visitor to use "Email Support" instead.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
