# ─── Server ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Database ─────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/campus-parking?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRE=7d

# ─── Email (Brevo SMTP) ───────────────────────────────────────────
# Get SMTP key from: brevo.com → Account → SMTP & API → SMTP tab
BREVO_USER=your_brevo_login_email@gmail.com
BREVO_SMTP_KEY=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── OTP ──────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGIN=https://your-app.onrender.com
