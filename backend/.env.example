# ─── Server ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Database ─────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/campus-parking?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRE=7d

# ─── Email (Brevo SMTP) ───────────────────────────────────────────
# Get SMTP key from: brevo.com → Account → SMTP & API → SMTP tab
BREVO_USER=your_brevo_login_email@gmail.com
BREVO_SMTP_KEY=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── OTP ──────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10

# ─── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Include your Render URL for the
# web app, PLUS the Android app's WebView origin(s) so the Capacitor APK's
# login/API/socket calls aren't blocked by CORS:
#   - capacitor://localhost   (default Capacitor Android scheme)
#   - https://localhost       (used if capacitor.config has androidScheme: 'https')
CORS_ORIGIN=https://your-app.onrender.com,capacitor://localhost,https://localhost

# ─── AI (chat assistant) ───────────────────────────────────────────
# Runs on our own trained TF-IDF/Logistic Regression model — no external
# API key needed. Start it with: python ai/api/app.py (see ai/README or
# root README for setup). AI_API_URL only needs to change if you run the
# Python API on a different host/port.
AI_API_URL=http://127.0.0.1:5001

# ─── EmailJS (Landing page → Help & Support → Contact Us) ─────────
# In your EmailJS dashboard: Account → Security, enable "Allow EmailJS API
# for non-browser applications" and use Private Key auth — that's exactly
# what these credentials are for, since this call happens server-side here,
# never in the browser bundle. Create an Email Service + Email Template
# (with {{from_name}}, {{from_email}}, {{message}} variables) and fill in:
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Address your EmailJS template should ultimately deliver to (also used by
# the frontend's "Email Support" mailto: link — keep both in sync).
SUPPORT_EMAIL=
